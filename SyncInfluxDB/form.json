                                    },
                                    {
                                        "caption": "Hz",
                                        "value": "Hz"
                                    },
                                    {
                                        "caption": "var",
                                        "value": "var"
                                    },
                                    {
                                        "caption": "kvar",
                                        "value": "kvar"
                                    }
                                ]
                            },
                            {
                                "type": "Button",
                                "caption": "Add",
                                "onClick": "IPS_RequestAction($id, 'BulkAdd', json_encode(['Parent' => $BulkParent, 'Recursive' => $BulkRecursive, 'OnlyLogged' => $BulkOnlyLogged, 'AggregationType' => $BulkAggregation, 'Unit' => $BulkUnit]));"
                            }
                        ]
                    }
                },
                {
                    "type": "Button",
                    "caption": "Sync now",
                    "onClick": "SINF_Sync($id);"
                },
                {
                    "type": "Button",
                    "caption": "Test connection",
                    "onClick": "SINF_TestConnection($id);"
                },
                {
                    "type": "PopupButton",
                    "caption": "Reset sync state",
                    "popup": {
                        "caption": "Reset sync state",
                        "items": [
                            {
                                "type": "Label",
                                "caption": "All selected variables will be re-transferred from the given point in time on the next sync. InfluxDB overwrites identical points, so no duplicates are created."
                            },
                            {
                                "type": "SelectDateTime",
                                "name": "ResetFrom",
                                "caption": "Re-sync from"
                            },
                            {
                                "type": "SelectVariable",
                                "name": "ResetVariable",
                                "caption": "Variable (none = all)"
                            },
                            {
                                "type": "Button",
                                "caption": "Reset",
                                "onClick": "IPS_RequestAction($id, 'ResetFromForm', json_encode(['VariableID' => $ResetVariable, 'From' => $ResetFrom]));",
                                "confirm": "Reset the sync state?"
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Sync active"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Sync inactive"
        },
        {
            "code": 200,
            "icon": "error",
            "caption": "InfluxDB not reachable or write rejected (see error above)"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Configuration incomplete"
        }
    ]
}